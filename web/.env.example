NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth — required for login. Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth: enable the Google provider in Supabase Dashboard → Authentication
# → Providers, then add this redirect URL in Google Cloud Console:
#   http://localhost:3000/auth/callback   (local)
#   https://your-domain.com/auth/callback (production)
# Supabase also needs the callback URL listed under Authentication → URL Configuration:
#   Site URL: http://localhost:3000 (or your production URL)
#   Redirect URLs: http://localhost:3000/auth/callback

# Legacy dev fallback (optional). Only used when Supabase auth is not configured.
# NEXT_PUBLIC_GRIMOIRE_USER_ID=
