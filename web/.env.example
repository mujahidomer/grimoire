NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth — required for login. Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (recommended on Railway/production). Used for OAuth redirects when
# the app runs behind a reverse proxy and request.url resolves to localhost internally.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google OAuth: enable the Google provider in Supabase Dashboard → Authentication
# → Providers, then add this redirect URL in Google Cloud Console:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Supabase URL Configuration (Authentication → URL Configuration):
#   Site URL: http://localhost:3000 (local) or https://your-domain.com (production)
#   Redirect URLs:
#     http://localhost:3000/auth/callback**
#     https://your-domain.com/auth/callback**
# The ** wildcard allows ?next= query params on the callback route.

# Legacy dev fallback (optional). Only used when Supabase auth is not configured.
# NEXT_PUBLIC_GRIMOIRE_USER_ID=
