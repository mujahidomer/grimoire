# ─── Grimoire backend env ─────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored.

# Anthropic (classification + chat). Already in use.
ANTHROPIC_API_KEY=
# Optional override for the chat model (default: claude-sonnet-4-6)
CHAT_MODEL=

# OpenAI — REQUIRED for embeddings + semantic search (Doc A items 7–9).
# Not previously present; add it before running the pipeline or migration.
OPENAI_API_KEY=
# Optional: cosine-similarity relevance threshold for semantic search (0..1).
# Below it, search returns nothing. Tune against the real library; default 0.4.
SEMANTIC_THRESHOLD=0.4

# Supabase — REQUIRED. Postgres is now the source of truth.
SUPABASE_URL=
# Service-role key (server-side only — bypasses RLS; never ship to a client).
SUPABASE_SERVICE_ROLE_KEY=
# Default user for local dev and for scripts/mint-api-token.js. No API route
# resolves a user from this on its own any more — see ALLOW_DEV_USER_FALLBACK.
GRIMOIRE_USER_ID=

# DEV ONLY — when 'true' (and NODE_ENV is not 'production'), requests without a
# Bearer token resolve to GRIMOIRE_USER_ID, and an x-user-id header is trusted
# without verification. That makes every API route unauthenticated, so it must
# never be set on a deployed environment. Leave unset in Railway/Vercel.
# ALLOW_DEV_USER_FALLBACK=true

# Allowed origin for the Next.js web UI (CORS). Defaults to any origin in dev.
# WEB_ORIGIN=http://localhost:3000

# Skip daily chat query limits for specific accounts (comma-separated).
# QUERY_LIMIT_BYPASS_EMAILS=you@example.com
# QUERY_LIMIT_BYPASS_USER_IDS=uuid-here

# Apify — scraping actor token for Instagram/Facebook extraction (lib/extractor.js).
APIFY_API_KEY=

# Supadata — REQUIRED for YouTube/TikTok/X video transcript extraction (lib/extractor.js).
SUPADATA_API_KEY=

# Google Drive/Sheets — now only needed by the one-time migration script.
GOOGLE_CREDENTIALS=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
# Optional: skip the Drive lookup for the registry sheet during migration.
SHEET_ID=

PORT=3000
