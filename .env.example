# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Google (paste the FULL contents of your JSON key file as a single line)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Drive — folder ID from the URL when you open your Grimoire folder
# e.g. https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# Server
PORT=3000
